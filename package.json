{
  "name": "paludarium",
  "version": "0.1.0",
  "description": "Build and simulate a living terrarium/aquarium in the browser. three.js + WebGPU.",
  "scripts": {
    "test": "node tools/test.cjs --query='fresh&webgl&lowres'",
    "test:sim": "node tools/test.cjs --query='fresh&webgl&lowres' --script=tools/fastforward.js --out=ff.png",
    "test:tools": "node tools/test.cjs --query='fresh&webgl&lowres' --script=tools/interact.js --out=tools.png",
    "serve": "python3 -m http.server 8000",
    "import-assets": "node tools/import-seedthree.cjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "camera-controls": "^3.1.2",
    "meshoptimizer": "^1.3.0",
    "playwright": "^1.56.0",
    "sharp": "^0.35.5",
    "three": "0.186.1",
    "three-mesh-bvh": "^0.9.15"
  },
  "private": true,
  "type": "commonjs"
}
